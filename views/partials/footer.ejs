<script>
    document.querySelectorAll(".edit-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
            btn.previousElementSibling.style.display = "block";
            btn.style.display = "none";
            const wrapper = btn.closest(".post-actions");
            wrapper.querySelector(".delete").style.display = "none";
        });
    });
    const postTextarea = document.getElementById("post");
    if (postTextarea) {
        function autoExpand() {
            postTextarea.style.height = "auto";
            postTextarea.style.height = postTextarea.scrollHeight + "px";
        }
        postTextarea.addEventListener("input", autoExpand);
        autoExpand();
    }
</script>
